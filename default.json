{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    "abandonments:recommended",
    "github>woodleighschool/renovate-config:annotated.json5",
    "github>woodleighschool/renovate-config:autoMerge.json5",
    "github>woodleighschool/renovate-config:labels.json5",
    "github>woodleighschool/renovate-config:semanticCommits.json5",
    "github>woodleighschool/renovate-config:groups.json5",
    "github>woodleighschool/renovate-config:sharedActions.json5",
    "security:gomodIndirectSecurityUpdates",
    ":automergePr",
    ":configMigration",
    ":dependencyDashboard",
    ":disableRateLimiting"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard \ud83e\udd16",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am on the first day of the month"],
    "commitMessageExtra": "({{manager}})",
    "additionalBranchPrefix": "{{manager}}-"
  },
  "npm": {
    "minimumReleaseAge": "1 day",
    "rangeStrategy": "bump"
  },
  "packageRules": [
    {
      "description": "Mise owns generated dependency sidecars; update tools through the mise manager",
      "matchManagers": ["npm"],
      "matchFileNames": ["**/.mise/locks/**"],
      "enabled": false
    },
    {
      "description": "Skip changelogs for AWS SDK Go v2",
      "matchSourceUrls": ["https://github.com/aws/aws-sdk-go-v2{/**,}"],
      "fetchChangeLogs": "off"
    }
  ]
}
