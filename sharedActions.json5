{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  customManagers: [
    {
      description: "Update shared action pins (per-action prefixed tags)",
      customType: "regex",
      managerFilePatterns: ["/\\.github/workflows/[^/]+\\.ya?ml$/"],
      matchStrings: [
        "uses: (?<owner>home-operations|woodleighschool)/\\.github/actions/(?<action>[\\w-]+)@(?<currentDigest>[a-f0-9]{40})\\s+#\\s+[\\w-]+-(?<currentValue>v?\\d+\\.\\d+\\.\\d+)",
      ],
      depNameTemplate: "{{{owner}}}/.github/actions/{{{action}}}",
      packageNameTemplate: "{{{owner}}}/.github",
      datasourceTemplate: "github-tags",
      extractVersionTemplate: "^{{{action}}}-(?<version>v?\\d+\\.\\d+\\.\\d+)$",
      versioningTemplate: "semver-coerced",
    },
  ],
  packageRules: [
    {
      description: "Leave prefixed action pins to the shared action manager",
      matchManagers: ["github-actions"],
      matchDepNames: ["home-operations/.github", "woodleighschool/.github"],
      matchDepTypes: ["action"],
      matchFileNames: [".github/workflows/*.yaml", ".github/workflows/*.yml"],
      matchCurrentValue: "/^[\\w-]+-v?\\d+\\.\\d+\\.\\d+$/",
      matchJsonata: ["$exists(currentDigest)"],
      enabled: false,
    },
    {
      matchManagers: ["custom.regex"],
      matchDepNames: ["home-operations/.github/actions/*", "woodleighschool/.github/actions/*"],
      groupName: "github-actions",
      minimumReleaseAge: "1 day",
      semanticCommitType: "chore",
      semanticCommitScope: "github-action",
      commitMessageTopic: "action {{depName}}",
      commitMessagePrefix: "{{semanticCommitType}}({{semanticCommitScope}}):",
    },
    {
      matchManagers: ["custom.regex"],
      matchDepNames: ["woodleighschool/.github/actions/*"],
      minimumReleaseAge: "0 days",
    },
  ],
}
