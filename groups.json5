{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  packageRules: [
    {
      description: "GitHub Actions Group",
      matchManagers: ["github-actions"],
      groupName: "github-actions",
    },
    {
      description: "Mise Tools Group",
      matchManagers: ["mise"],
      groupName: "mise tools",
      groupSlug: "mise-tools",
    },
    {
      description: "Go Toolchain Group",
      matchManagers: ["mise"],
      matchDepNames: ["go", "golangci-lint"],
      matchFileNames: [".mise/config.toml"],
      groupName: "Go toolchain",
      groupSlug: "go-toolchain",
    },
    {
      description: "Rust Toolchain Group",
      matchManagers: ["mise"],
      matchDepNames: ["rust"],
      matchFileNames: [".mise/config.toml"],
      groupName: "Rust toolchain",
      groupSlug: "rust-toolchain",
    },
    {
      description: "Node Toolchain Group",
      matchManagers: ["mise"],
      matchDepNames: ["node"],
      matchFileNames: [".mise/config.toml"],
      groupName: "Node toolchain",
      groupSlug: "node-toolchain",
    },
    {
      description: "pnpm Group",
      matchManagers: ["mise", "npm"],
      matchDepNames: ["pnpm"],
      matchFileNames: [".mise/config.toml", "**/package.json"],
      groupName: "pnpm",
      groupSlug: "pnpm",
    },
    {
      description: "React Runtime Group",
      matchManagers: ["npm"],
      matchPackageNames: ["react", "react-dom"],
      matchFileNames: ["**/package.json"],
      groupName: "React runtime",
      groupSlug: "react-runtime",
    },
    {
      description: "zer0ver: 0.x minors can break at any time, route them onto the major branches",
      matchUpdateTypes: ["minor"],
      matchCurrentVersion: "/^v?0\\./",
      additionalBranchPrefix: "major-",
    },
  ],
}
