{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    "abandonments:recommended",
    "github>woodleighschool/renovate-config:annotated.json5",
    "github>woodleighschool/renovate-config:groups.json5",
    "github>woodleighschool/renovate-config:helmPostUpgradeTasks.json5",
    "github>woodleighschool/renovate-config:labels.json5",
    "github>woodleighschool/renovate-config:semanticCommits.json5",
    "github>woodleighschool/renovate-config:sharedActions.json5",
    "security:gomodIndirectSecurityUpdates",
    ":automergePr",
    ":configMigration",
    ":dependencyDashboard",
    ":disableRateLimiting"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am on the first day of the month"],
    "commitMessageExtra": "({{manager}})",
    "additionalBranchPrefix": "{{manager}}-"
  },
  "packageRules": [
    {
      "description": "NPM Bump Range Strategy",
      "matchManagers": ["npm"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Auto-merge non-major updates, but only after every CI check passes",
      "matchUpdateTypes": ["minor", "patch", "digest", "lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "zer0ver: 0.x minors can break at any time, don't automerge them",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^v?0\\./",
      "automerge": false
    }
  ]
}
