{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigestsToSemver",
    "abandonments:recommended",
    "./annotated.json5",
    "./autoMerge.json5",
    "./labels.json5",
    "./semanticCommits.json5",
    "./groups.json5",
    "./sharedActions.json5",
    "security:gomodIndirectSecurityUpdates",
    ":automergePr",
    ":configMigration",
    ":dependencyDashboard",
    ":disableRateLimiting"
  ],
  "dependencyDashboardTitle": "Renovate Dashboard 🤖",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 3am on the first day of the month"],
    "commitMessageExtra": "({{manager}})",
    "additionalBranchPrefix": "{{manager}}-"
  },
  "npm": {
    "minimumReleaseAge": "1 day",
    "rangeStrategy": "bump"
  },
  "packageRules": [
    {
      "description": "Skip changelogs for AWS SDK Go v2",
      "matchSourceUrls": ["https://github.com/aws/aws-sdk-go-v2{/**,}"],
      "fetchChangeLogs": "off"
    }
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**",
    "**/examples/**",
    "**/__tests__/**",
    "**/test/**",
    "**/tests/**",
    "**/__fixtures__/**",
    "**/.mise/locks/**"
  ]
}
